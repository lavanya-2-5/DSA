8)  // Longest Consecutive sequence.

class Solution {
    public int longestConsecutive(int[] nums) {
        Set<Integer> set=new HashSet<>();
        for(int i:nums){                                         //adding all elements in the set.
            set.add(i);
        }
        int longestL=0;
        for(int num:set){
            if(!set.contains(num-1)){                         //if num-1 doesnt exist in the set, it means nums is the smallest values, start counting the greater elements. 
                int currentL=1;
                int currNum=num;
                while(set.contains(currNum+1)){
                    currentL++;
                    currNum++;
                }
              longestL=Math.max(longestL,currentL);             //store the longest sequence to compare with the future sequence.
            }
        }
        return longestL;
    }
}


9)  // Longest Substring Without Repeating Characters.

class Solution {
    public int lengthOfLongestSubstring(String s) {
        int start=0;
        int end=0;
        int maxLength=0;
        HashSet<Character> set=new HashSet<>();
         while(end<s.length()){
            char current=s.charAt(end);
            if(!set.contains(current)){                           //if the char is unique , then add it to the set and increase the end pointer.
                set.add(current);
                maxLength=Math.max(maxLength,end-start+1);
                end++; 
            }
            else{
                set.remove(s.charAt(start));                        //if it is duplicate, then remove from the set and shrink the window until a valid window is found.
                start++;
            }
         }
         return maxLength;
    }
}


10)  // Bulls And Cows.

APPROACH 1- Using HashMap(2 passes)
class Solution {
    public String getHint(String secret, String guess) {
        int bulls=0;
        int cows=0;
        HashMap<Character,Integer> map=new HashMap<>();
        for(int i=0;i<secret.length();i++){                        //1st pass for bulls.
            char s=secret.charAt(i);
            char g=guess.charAt(i);
            if(s==g){
                bulls++;                                      //if both characters are equal at the same index then bulls++.
            }else{
                map.put(s,map.getOrDefault(s,0)+1);            //otherwise add in the map with their frequency.
            }
        }
        for(int i=0;i<secret.length();i++){                        //2nd pass for cows.
            char s=secret.charAt(i);
            char g=guess.charAt(i); 
            if(s!=g && map.containsKey(g)&& map.get(g)>0){             //index should not be equal, must exist in map, freq must be greater than 0.
                cows++;
                map.put(g,map.get(g)-1);
            }
        }
        return bulls+"A"+cows+"B";
    }
}

APPROACH 2- Using Arrays(1 pass balance).
class Solution {
    public String getHint(String secret, String guess) {
     int bulls=0;
     int cows=0;
     int[] arr=new int[10];                                  //taking an array of size 10.
     for(int i=0;i<secret.length();i++){
        int s=secret.charAt(i)-'0';
        int g=guess.charAt(i)-'0';
        if(s==g) bulls++;
        else{
            if(arr[s]<0) cows++;
            if(arr[g]>0) cows++;
            arr[s]++;
            arr[g]--;        
     } 
     }  
     return bulls+"A"+cows+"B";
    }
}


11)  // Largest Subarray with 0 Sum.

class Solution {
    int maxLength(int arr[]) {
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0,-1);                                      //initially put 0 as sum and -1 as first index.
        int sum=0;
        int maxl=0;
        for(int i=0;i<arr.length;i++){                   
            sum=sum+arr[i];                                     //keep calculating prefix sum for each index.
            if(map.containsKey(sum)){                           //if sum exist in the hashmap then update maxlen.
                maxl=Math.max(maxl,i-map.get(sum));
            }else{                                             //if sum doesnt exist in the hashmap, then put it in the map.
                map.put(sum,i);
            }
        }
        return maxl;
    }
}


12)  // Counting all 0 sum subarrays.

class Solution {
    public int findSubarray(int[] arr) {
        int count=0;
        int sum=0;
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0,1);                                           //taking sum and frequency in the map.
        for(int i=0;i<arr.length;i++){
            sum=sum+arr[i];
            if(map.containsKey(sum)){                            //if the element exist in the map, then increase count by the frequency and also increase the freq. in map.
                count+=map.get(sum);
            }
                map.put(sum,map.getOrDefault(sum,0)+1);
        }
        return count;
    }
}


13)  // Length of largest subarray with contiguous element.

class Solution {
    public int findMaxLength(int[] nums) {
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0,-1);                                            //initially take 0 as sum and -1 as index.
        int sum=0;
        int maxl=0;
        for(int i=0;i<nums.length;i++){
          if(nums[i]==0){                                         //if element is 0 then do -1 from prefix sum , and if element is 1 then do +1 in prefix sum.
            sum=sum-1;
          }else{
            sum=sum+1;
          }
          if(map.containsKey(sum)){
            maxl=Math.max(maxl,i-map.get(sum));                     //if the prefix sum exist in the map then, update the maxlen, otheriwse put in the map.
          }else{
            map.put(sum,i);
          }
        }
        return maxl;
    }
} 
