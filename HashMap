5)  // Intersection of Two Arrays.

class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        HashSet<Integer> set1=new HashSet<>();                          //adding all elements of nums1 to set1.
        for(int num:nums1){
            set1.add(num);
        }
        HashSet<Integer> resultset=new HashSet<>();                     //matching the elements of nums2 with nums1 and adding to another hashset to ensure unique elements.
        for(int num:nums2){
            if(set1.contains(num)){
                resultset.add(num);
            }
        }
        int[] arr=new int[resultset.size()];                         //transfer the elements to an array to return.
        int i=0;
        for(int num:resultset){
            arr[i++]=num;
        }
        return arr;
    }
}


6)  // Set Matrix Zeroes.

class Solution {
    public void setZeroes(int[][] matrix) {
        int col0=1;                                        //col0 states if column 0 has to be 0 or not in the last.
        int rows=matrix.length; 
        int cols=matrix[0].length; 
        for(int i=0;i<rows;i++){                               
            if(matrix[i][0]==0) col0=0;                     //if any of the element in the 0th column is 0 then set col0 to 0.
            for(int j=1;j<cols;j++){
                if(matrix[i][j]==0){                          //if any element is 0 from 1st col. to last ,then set its topmost and leftmost to 0.
                    matrix[i][0]=matrix[0][j]=0;
                }
            }
        }
        for(int i=rows-1;i>=0;i--){                           //traverse from the bottom right .
            for(int j=cols-1;j>=1;j--){
                if(matrix[i][0]==0 || matrix[0][j]==0){        //for every element , if its topmost or rightmost is 0 then set it to 0.
                    matrix[i][j]=0;
                }}
                if(col0==0) {                                  // if col0 is 0 then whole column0 will be set to 0 otherwise no change.
                    matrix[i][0]=0;
        }
        }
    }
}


