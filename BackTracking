1)  // Escape a large maze.

class Solution {
    static final int LIM=(200*199)/2;                                            // Max cells that 200 blocks can enclose.
    public boolean isEscapePossible(int[][] blocked, int[] source, int[] target) {
      Set<Long> blockset=new HashSet<>();
      for(int[] b:blocked){                                                            // Convert blocked cells to HashSet for O(1) lookup.
        blockset.add(encode(b[0],b[1]));
      }
     return bfs(source, target,blockset) && bfs(target,source,blockset);                     // Check both directions.
    }

    static boolean bfs(int[] source, int[] target,Set<Long> blockset){
    Queue<int[]> q=new LinkedList<>();
    Set<Long> vis=new HashSet<>();
    q.offer(source);
    vis.add(encode(source[0],source[1]));
    int[][] dir={{1,0},{-1,0},{0,-1},{0,1}};
    while(!q.isEmpty()){
        int[] curr=q.poll();
        if(curr[0]==target[0] && curr[1]==target[1]){                          // If we reached the destination.
            return true;
        }
        for(int[] d:dir){
            int nx=curr[0]+d[0];
            int ny=curr[1]+d[1];
        
        if(nx<0 || ny<0 || nx>=1_000_000 || ny>=1_000_000){
            continue;
        }
        long c=encode(nx,ny);
        if(blockset.contains(c) || vis.contains(c)){
            continue;
        }
        vis.add(c);
        q.offer(new int[]{nx,ny});
    } 
    if(vis.size()>LIM){                                             // Escaped the possible enclosure.
        return true;
    }
    }
    return false;                                        // BFS ended without escape or reaching target → trapped.
    }
    private static long encode(int x,int y){                               // Encode (x, y) into one long value.
        return ((long)x<<20) | y;
    }
}
Time- O(20,000)
Space- O(20,000).


2)  // N-Queens.

class Solution {
    List<List<String>> res;
    boolean[] col,d1,d2;
    int n;
    public List<List<String>> solveNQueens(int n) {
       this.n=n;
       res=new ArrayList<>();
       col=new boolean[n];
       d1=new boolean[2*n];
       d2=new boolean[2*n];
       char[][] brd=new char[n][n];
       for(int i=0;i<n;i++){
        Arrays.fill(brd[i],'.');
       }
       dfs(brd,0);
       return res;
    }
    public void dfs(char[][] brd,int row){
    if(row==n){
        List<String> rows=new ArrayList<>();
        for(char[] r:brd){
         rows.add(new String(r));
        }
        res.add(rows);
        return;
    }
    for(int c=0;c<n;c++){
        int dg1=row-c+n-1;
        int dg2=row+c;
        if(col[c] || d1[dg1] || d2[dg2]) continue;

        brd[row][c] = 'Q';                                    // place queen.             
        col[c] = d1[dg1] = d2[dg2] = true;
        dfs(brd, row + 1);

        brd[row][c] = '.';                                      // backtrack.
            col[c] = d1[dg1] = d2[dg2] = false;
    }
    } 
}
Time-O(N!)
Space-O(N^2).


3)  // Combinations-Given two integers n and k, return all possible combinations of k numbers chosen from the range [1, n].

class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> combine(int n, int k) {
        backtrack(1,n,k,new ArrayList<>());
        return ans;
    }
    public void backtrack(int start,int n,int k,List<Integer> path){                    // backtrack(start,path)
        if(path.size()==k){                                                         //  if condition met.
            ans.add(new ArrayList<>(path));                                          //  add path to result.
            return;                                                                  // return back.
        }
        for(int i=start;i<=n-(k-path.size())+1;i++){
            path.add(i);                                                      // choose i.
            backtrack(i+1,n,k,path);                                           // backtrack(i+1)->we dont want repeated values.
            path.remove(path.size()-1);                                       // undo choice.
        }
    }
}
Time-O(c(n,k))
Space-O(k)


4)  // Combination Sum.

BRUTEFORCE APPROACH-
class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        backt(candidates,target,0,new ArrayList<>());
        return ans;
    }
    public void backt(int[] candidates,int target,int start,List<Integer> path){
        if(target==0){
            ans.add(new ArrayList<>(path));
            return;
        }
        if(target<0){
            return;
        }
        for(int i=start;i<candidates.length;i++){
            path.add(candidates[i]);
            backt(candidates,target-candidates[i],i,path);
            path.remove(path.size()-1);
        }
    }
}
Time-O(2^(target/minCand.))
Space-O(target/minCand)

OPTIMIZED CODE-
class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        Arrays.sort(candidates);                                                //sorting for optimization.
        backt(candidates,target,0,new ArrayList<>());
        return ans;
    }
    public void backt(int[] candidates,int target,int start,List<Integer> path){
        if(target==0){
            ans.add(new ArrayList<>(path));
            return;
        }
        
        for(int i=start;i<candidates.length;i++){
            if(candidates[i]>target) break;                                            // big numbers are pruned.
            path.add(candidates[i]);                                                 //choose i.
            backt(candidates,target-candidates[i],i,path);                           //backtrack with i because we can reuse numbers.
            path.remove(path.size()-1);                                         //undo choice.
        }
    }
}
Much fewer branches are explored because:
Large numbers are cut early
Tree is significantly pruned


5)  // Combination Sum-2.

class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> combinationSum2(int[] candidates, int target) {
       Arrays.sort(candidates);                                                      //sorting for optimiz.
        backt(0,candidates,target,new ArrayList<>());
        return ans;
    }
    public void backt(int start,int[] cand,int target,List<Integer> path){
        if(target==0){
            ans.add(new ArrayList<>(path));
            return;
        }
        for(int i=start;i<cand.length;i++){
            if(i>start && cand[i]==cand[i-1]) continue;                                      //extra rule for skipping the duplicate values in the arrays.
         if(cand[i]>target) break;                                                       //pruning the large numbers.
         path.add(cand[i]);
         backt(i+1,cand,target-cand[i],path);
         path.remove(path.size()-1);
        }
    }
}
Time-Worst case-O(2^n)
Sapce-O(n)


6)  // Generate Parenthesis.

class Solution {
    List<String> ans=new ArrayList<>();
    public List<String> generateParenthesis(int n) {
        backt(new StringBuilder(),0,0,n);
        return ans;
    }
    public void backt(StringBuilder sb,int op,int cl,int n){
        if(sb.length()==2*n){
            ans.add(sb.toString());
            return;
        }
        if(op<n){                                                       //open brackets should be less than n, then only we will ad more open brackets.
            sb.append('(');                                                 //choose i.
            backt(sb,op+1,cl,n);                                          //backtrack.
             sb.deleteCharAt(sb.length()-1);                             //undo choice.
        }
        if(cl<op){                                                        //close should be less than open brackets .
            sb.append(')');                                                  //choose i.
            backt(sb,op,cl+1,n);                                         // backtrack.
            sb.deleteCharAt(sb.length()-1);                             //undo choice.
        }
    }
}
Time- O(Cn) where Cn is a catalan number sequence-O(4^n / n^(3/2))
Space-O(N).


7)  // Subsets- Given an integer array nums of unique elements, return all possible subsets .
The solution set must not contain duplicate subsets. Return the solution in any order.

class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> subsets(int[] nums) {
        backt(nums,0,new ArrayList<>());
        return ans;
    }
    public void backt(int[] nums,int start,List<Integer> path){
      
         ans.add(new ArrayList<>(path));                                //every subset is a valid subset so we add at every node.
         
        for(int i=start;i<nums.length;i++){
            path.add(nums[i]);
            backt(nums,i+1,path);
            path.remove(path.size()-1);
        }
    }
}
Time- O(n.2^n)
Space- O(n.2^n) , auxialiary space used-O(n).

ITERATIVE APPROACH-
class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        ans.add(new ArrayList<>()); // empty subset

        for (int num : nums) {
            int size = ans.size();
            for (int i = 0; i < size; i++) {
                List<Integer> temp = new ArrayList<>(ans.get(i));
                temp.add(num);
                ans.add(temp);
            }
        }
        return ans;
    }
}
Time: O(n * 2^n)
Space: O(n * 2^n) (output)

Bit Manipulation-
class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        int n = nums.length;

        for (int mask = 0; mask < (1 << n); mask++) {
            List<Integer> subset = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                if ((mask & (1 << i)) != 0) {
                    subset.add(nums[i]);
                }
            }
            ans.add(subset);
        }
        return ans;
    }
}


8)  // Subsets 2- Given an integer array nums that may contain duplicates, return all possible subsets.
The solution set must not contain duplicate subsets. Return the solution in any order.

class Solution {
    List<List<Integer>> ans=new ArrayList<>();
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        Arrays.sort(nums);
        backt(nums,0,new ArrayList<>());
        return ans;
    }
    public void backt(int[] nums,int start,List<Integer> path){
        ans.add(new ArrayList<>(path));
        for(int i=start;i<nums.length;i++){
            if(i>start && nums[i]==nums[i-1]) continue;
            path.add(nums[i]);
            backt(nums,i+1,path);
            path.remove(path.size()-1);
        }
    }
}
Time - total-O(nlon +n.2^n) -> n.2^n
Space- auxiliray + output->n.2^n


9)  // Sudoku Solver

class Solution {
    public void solveSudoku(char[][] board) {
     solve(board);
    }
    public boolean solve(char[][] board){
            for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                if(board[i][j]=='.'){
                    for(char c='1';c<='9';c++){
                        if(isVal(board,i,j,c)){
                           board[i][j]=c;
                           if(solve(board)){
                            return true;
                           }
                            board[i][j]='.';   
                    }
                }
                return false;
            }
        }
    }
        return true;
    }
    public boolean isVal(char[][] board,int row,int col,char c){
        for(int i=0;i<9;i++){
            if(board[i][col]==c){
                return false;
            }
            if(board[row][i]==c){
                return false;
            }
            if(board[3*(row/3)+i/3][3*(col/3)+i%3]==c){
                return false;
            }
        }
        return true;
    }
}
Time-O(9^empty cells).
Space-O(81)
