1)  // Implementation of Stack.

class Stack {
    private static final int STACK_CAPACITY = 101;
    private char[] stackArray = new char[STACK_CAPACITY];
    private int topIndex = -1;
    void push(char character) {
        if(isFull()){                                               // If stack is full (check using isFull function)
            System.out.println("Stack is full");                            // Then print "Stack is full"
        }else{                                                      // Otherwise add the next element at topIndex + 1 and update topIndex.
            stackArray[++topIndex]=character;
        }
    }
    char pop() {
        if(isEmpty()){                                              // If the stack is empty (check using isEmpty function).
            System.out.println("Stack is empty");                         // Then print "Stack is empty" and return '0'.
            return '\0';                                                      // Otherwise return the element at the topIndex.
        }else{
            return stackArray[topIndex--];                                     // But reduce topIndex before returning the element.
        }
    }
    boolean isEmpty() {
        return topIndex == -1;
    }
    boolean isFull() {
        return topIndex >= STACK_CAPACITY - 1;
    }
}
class ReverseString {
    public static void main(String[] args) {
        String inputString = "Hello, World!";
        int inputLength = inputString.length();
        Stack charStack = new Stack();
        for (int i = 0; i < inputLength; i++) {                     // Push each character onto the stack.
            char currentChar = inputString.charAt(i);
            charStack.push(currentChar);
        }
        StringBuilder reversedString = new StringBuilder();             // Pop the characters from the stack to construct the reversed string.
        while (!charStack.isEmpty()) {
            reversedString.append(charStack.pop());
        }
        System.out.println(reversedString.toString());
    }
}


2)  // Next greater element 1. (Monotonic Stack + Hashmap)

class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        Stack<Integer> stack=new Stack<>();                        
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int num:nums2){
            while(!stack.isEmpty() && stack.peek()<num){                      //Remove smaller elements when a bigger one comes.
                 map.put(stack.pop(),num); 
            }                                                               //Elements waiting for their next greater element.
            stack.push(num);
        }
        int[] ans=new int[nums1.length];
        for(int i=0;i<nums1.length;i++){
        ans[i]=map.getOrDefault(nums1[i],-1);
        }
        return ans;
    }
}
//The stack stores elements that haven’t yet found a greater element to their right. When a bigger number appears, it resolves all smaller elements on the stack.


3)  // Find Smaller on left.(Based On TreeSet).

class Complete {

    // Function for finding maximum and value pair
    public static int[] Smallestonleft(int arr[], int n) {
      int[] ans=new int[n];
      TreeSet<Integer> tset=new TreeSet<>();                            //like a rbtree ,always keeps elements sorted.
      for(int i=0;i<n;i++){
          Integer val=tset.lower(arr[i]);                          //set.lower() gives value exactly < arrr[i].
          if(val==null){                                       //if no value exists.
              ans[i]=-1;
          }else{
              ans[i]=val;
          }
          tset.add(arr[i]);
      }
      return ans;
    }
}


4)  // Valid Parentheses.

class Solution {
    public boolean isValid(String s) {
       Stack<Character> stack=new Stack<>();
       for(char c:s.toCharArray()){                  //if opening bracket is encountered,then push closing bracket.
        if(c=='('){                                  //if closing bracket is encountered,then check the popped value matches it or not.
            stack.push(')');
        }
        else if(c=='{'){
                stack.push('}');
        }
        else if(c=='['){
            stack.push(']');
        }
        else if(stack.isEmpty() || stack.pop()!=c){
            return false;
        }
       } 
       return stack.isEmpty();
    }
}


5)  // Min Stack.

class MinStack {
    Stack<Integer> stack;
    Stack<Integer> minstack;
    public MinStack() {
        stack=new Stack<>();
        minstack=new Stack<>();
    }
    public void push(int val) {
        stack.push(val);
        if(minstack.isEmpty() || val<=minstack.peek()){
            minstack.push(val);
        }
    } 
    public void pop() {
        int popped=stack.pop();
        if(popped==minstack.peek()){
            minstack.pop();
        }
    }
    public int top() {
        return stack.peek();
    } 
    public int getMin() {
        return minstack.peek();
    }
}


6)  // Asteroid collisions

class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        Stack<Integer> stack=new Stack<>();
        for(int num:asteroids){
            Boolean alive=true;
            while(alive && !stack.isEmpty() && stack.peek()>0 && num<0){
                if(stack.peek()<-num){
                    stack.pop();
                }else if(stack.peek()==-num){
                    stack.pop();
                    alive=false;
                }else{
                    alive=false;
                }
            }
            if(alive){
                stack.push(num);
            }
        }
        int[] arr=new int[stack.size()];
        for(int i=arr.length-1;i>=0;i--){
            arr[i]=stack.pop();
        }
        return arr;
    }
}
This is a stack simulation problem.
Collision occurs only when a positive asteroid meets a negative one.
I use a stack to simulate collisions and resolve them using a while loop.

7)  // Online Stock Span.

class StockSpanner {                            //monotonic decreasing stack is used. 
     Stack<int[]> stack;
    public StockSpanner() {
        stack=new Stack<>();
    }
    
    public int next(int price) {
        int span=1;
        while(!stack.isEmpty() && stack.peek()[0]<=price){
           span=span+stack.peek()[1];
           stack.pop();
        }
        stack.push(new int[]{price,span});
        return span;
    }
} 
I use a monotonic decreasing stack storing (price, span). I merge spans while popping smaller prices.
