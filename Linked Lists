15)  // Merge k sorted lists.

1) Insert the first node of every list into the heap.
2) Remove the smallest node from the heap.
3) Add it to the result list.
4) If that node has a next node, insert it into the heap.
5) Repeat until heap becomes empty.

class Solution {
    public ListNode mergeKLists(ListNode[] lists) {
        PriorityQueue<ListNode> pq=new PriorityQueue<>((a,b)->a.val-b.val);
        for(ListNode node:lists){
            if(node!=null){
                pq.add(node);
            }
        }
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        ListNode temp=dummy;
        while(!pq.isEmpty()){
            ListNode minNode=pq.poll();
            temp.next=minNode;
            temp=temp.next;
            if(minNode.next!=null){
                pq.add(minNode.next);
            }
        }
        return dummy.next;
    }
}
Time-O(n log k)
Space-O(k)

Another Approach-
Repeatedly merge two lists.
class Solution {
    public ListNode mergeKLists(ListNode[] lists) {
        if(lists == null || lists.length == 0) return null;
        return divide(lists, 0, lists.length - 1);
    }
    public ListNode divide(ListNode[] lists, int left, int right){
        if(left == right){                                                   // if single list is there then return it.
            return lists[left];
        }
        int mid = left + (right - left) / 2;                                     // keep dividing until it becomes 1.
        ListNode l1 = divide(lists, left, mid);
        ListNode l2 = divide(lists, mid + 1, right);
        return mergeTwoLists(l1, l2);
    }
    public ListNode mergeTwoLists(ListNode l1, ListNode l2){
        ListNode dummy = new ListNode(-1);
        ListNode temp = dummy;
        while(l1 != null && l2 != null){
            if(l1.val <= l2.val){
                temp.next = l1;
                l1 = l1.next;
            }
            else{
                temp.next = l2;
                l2 = l2.next;
            }
            temp = temp.next;
        }
        if(l1 != null) temp.next = l1;
        else temp.next = l2;
        return dummy.next;
    }
}
Time-O(n log k)
Space-O(1)


16)  // Sort lists.

1) Find the middle of the list
2) Split the list into two halves
3) Sort each half recursively
4) Merge the two sorted halves

class Solution {
    public ListNode sortList(ListNode head) {
        if(head == null || head.next == null){
            return head;
        }
        ListNode mid = getMiddle(head);             
        ListNode right = mid.next;                                  // making the list after mid as right list.
        mid.next = null;                                              // separating the list after mid.
        ListNode leftSorted = sortList(head);                           // again dividing the left list using mid.
        ListNode rightSorted = sortList(right);                          
        return merge(leftSorted, rightSorted);
    }
    public ListNode getMiddle(ListNode head){                                // finding middle using slow fast pointer.
        ListNode slow = head;
        ListNode fast = head.next;                                                // here the fast pointer starts from the head.next.
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow;                                              // returning mid.
    }
    public ListNode merge(ListNode l1, ListNode l2){                      // same logic for merging 2 list.
        ListNode dummy = new ListNode(-1); 
        ListNode temp = dummy;
        while(l1 != null && l2 != null){
            if(l1.val <= l2.val){
                temp.next = l1;
                l1 = l1.next;
            }
            else{
                temp.next = l2;
                l2 = l2.next;
            }
            temp = temp.next;
        }
        if(l1 != null) temp.next = l1;
        else temp.next = l2;
        return dummy.next;
    }
}
Time-O(n log n)
Space-O(log n)


17)  // Reorder List.

1) Find middle and split the list.
2) Reverse the 2nd half.
3) Merge alternatively.

class Solution {
    public void reorderList(ListNode head) {
        if(head==null || head.next==null) return;
        ListNode slow=head;
        ListNode fast=head;
        while(fast.next!=null && fast.next.next!=null){             // slow will land on first middle for even length list.
            slow=slow.next;
            fast=fast.next.next;
        }
        ListNode second=reverse(slow.next);
        slow.next=null;                                      // split the list.
        ListNode first=head;
        while(second!=null){                                   // merge alternatively.
            ListNode temp1=first.next;
            ListNode temp2=second.next;
            first.next=second;
            second.next=temp1;
            first=temp1;
            second=temp2;
        }
    }
    public static ListNode reverse(ListNode node){
      ListNode prev=null;
      while(node!=null){
       ListNode nextnode=node.next;
       node.next=prev;
       prev=node;
       node=nextnode;
      }
      return prev;
    }
}
Time-O(n)
Space-O(1)


18)  // Rotate List by k steps.

1) find length of list
2) reduce k and make the list circular
3) find new tail by length-k
4) break the circle from the new tail.

class Solution {
    public ListNode rotateRight(ListNode head, int k) {
        if(head==null || head.next==null || k==0) return head;
        ListNode temp=head;
        int l=1;
        while(temp.next!=null){
            temp=temp.next;                            // finding the length of the list.
            l++;
        }
       k=k%l;                                                // reducing k.
       if(k==0) return head;
       temp.next=head;                                          // making a cycle.
       ListNode newtail=head;                                
       int steps=l-k;                                       // finding the newtail.
       for(int i=1;i<steps;i++){
         newtail=newtail.next;
       }
       ListNode newhead=newtail.next;                         // make the next of newtail as newhead
       newtail.next=null;                                        // break the cycle between the newtail and newhead.
     return newhead;
    }
}
Time-O(n)
Space-O(1)


19)  // Linked List Cycle 2.

* distance(head → cycle start) = distance(meeting point → cycle start)
1) find the meeting point of slow and fast pointers.
2) break after a cycle is present. if no cycle present then return null.
3) start a pointer from head and the slow pointer from the meeting point as the distance is equal so they will meet at the cycle start. return that node.

public class Solution {
    public ListNode detectCycle(ListNode head) {
        if(head==null || head.next==null) return null;
        ListNode slow=head;
        ListNode fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
            if(slow==fast){                                         // break at the meeting point using slow-fast pointers.
                 break;
            }
        }
    if(fast==null || fast.next==null) return null;                   // if no cycle present then fast will reach null so return null.
        ListNode first=head;                                      // traverse from the head and the slow pointer equally till they meet.
        while(first!=slow){
         first=first.next;
         slow=slow.next;                                               // the point where they meet is the starting point of the cycle.
        }
        return first;
    }
}
Time-O(n)
Space-O(1)


20)  // Reverse nodes in K groups.

1) find kth node.
2) reverse the group.
3) reconnect the dummy node to the kth node because it is still pointing to the first node.
4) move the pointer.

class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        ListNode prevG=dummy;                                                // connect the dummy with head.
        dummy.next=head;
        while(true){
            ListNode kth=findkth(prevG,k);                                  // find the kth node if k nodes exist in the group.
            if(kth==null) break;                                            // if k nodes does not exist, break.
            ListNode nextG=kth.next;
            ListNode prev=nextG;                                               // use 3 pointer tech. for reversing each group.
            ListNode curr=prevG.next;
            while(curr!=nextG){
                ListNode tmp=curr.next;
                curr.next=prev;
                prev=curr;
                curr=tmp;
            }
            ListNode temp=prevG.next;                                  // reconnect the dummy.
            prevG.next=kth; 
            prevG=temp;                                                       // move the prevG pointer to the reversed group's last node.
        }
        return dummy.next;
    }
    public static ListNode findkth(ListNode curr,int k){
        while(curr!=null && k>0){                                         // for finding the kth node.
            curr=curr.next;
            k--;
        }
        return curr;
    }
}
Time-O(n)
Space-O(1)


21)  //  Split Linked lists in parts.

# mark start → move size nodes → cut → move to next.
class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {
        ListNode[] res=new ListNode[k];
        ListNode curr=head;
        int len=0;
        while(curr!=null){
        curr=curr.next;
        len++;                                               // counting the length.
        }
        int elements=len/k;                                    // finding how many elements will be there in each group except the extras.
        int extras=len % k;                                    // finding how many extra nodes left at the end.
        curr=head; 
        for(int i=0;i<k;i++){                                      
            res[i]=curr;                                     // storing the first node in the list and also the connected ones.
            int size=elements+(extras>0?1:0);                 // calculating size for each group.
            if(extras>0){                                      // decrementing the size after every group.
                extras--;
            }
            for(int j=1;j<size;j++){                         // moving the curr pointer to the last of each group for splitting.
                if(curr!=null){
                curr=curr.next;
            }
            }
            if(curr!=null){
            ListNode nextnode=curr.next;                         // splitting.
            curr.next=null;
            curr=nextnode;
        }
        }
        return res;
    }
}
Time-O(n+k)
Space-O(k)


