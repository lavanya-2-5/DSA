class Solution {
    public ListNode swapPairs(ListNode head) {
        ListNode dummy=new ListNode(-1);
        ListNode prev=dummy;
        dummy.next=head;                                                   // join the dummy node with the head.
        while(prev.next!=null && prev.next.next!=null){
            ListNode first=prev.next;
            ListNode second=prev.next.next;
            first.next=second.next;                                      // swapping logic using 3 pointers.
            second.next=first;
            prev.next=second;
            prev=first;                                                     // jump the prev pointer to first.
        }
        return dummy.next;
    }
}
Time-O(n)
Space-O(1)


23)  // Remove zero sum consecutive nodes from linked list.   

* use prefix sum + hashmap solution.(2 pass) 
class Solution {
    public ListNode removeZeroSumSublists(ListNode head) {
        Map<Integer,ListNode> map=new HashMap<>();
        ListNode dummy=new ListNode();
        dummy.next=head;
        int sum=0;
        ListNode curr=dummy;
        while(curr!=null){
            sum+=curr.val;                                // calculate sum and put into hashmap (sum,curr).
            map.put(sum,curr);
            curr=curr.next;
        }
        sum=0;                                                // again make sum 0 .
        curr=dummy;
        while(curr!=null){
            sum=sum+curr.val;
            curr.next=map.get(sum).next;                     // jump to the node AFTER the last occurrence of this prefix sum.
            curr=curr.next;
        }
        return dummy.next;
    }
}
Time-O(n)
Space-O(n)


24)  //  Partition List.

1) Create 2 dummy nodes.
2) Traverse list.
3) Append node to appropriate list.
4) Connect the two lists.

class Solution {
    public ListNode partition(ListNode head, int x) {
        ListNode dummyG=new ListNode(0);
        ListNode dummyL=new ListNode(0);
        ListNode big=dummyG;
        ListNode small=dummyL;                                    // created pointers for both dummy nodes.
        ListNode curr=head;                                      // traverse the original list and keep comparing.
        while(curr!=null){
            if(curr.val>=x){
                big.next=curr;
                big=big.next;
            }else{
                small.next=curr;
                small=small.next;
            }
            curr=curr.next;
        }
        big.next=null;                                             // connect the big list end to null.
        small.next=dummyG.next;                                    // connect the small list end to big list head.
        return dummyL.next;                                         
    }
}
Time-O(n)
Space-O(1)


25)  // Flatten a multilevel doubly linked list.

1) Start traversal & Save the next node.
2) Check if child exists.
3) If child exists → flatten child list.
4) Attach child list after current node & Connect child tail with saved next.
5) Remove child pointer & Update last pointer, Move curr to child tail & Continue traversal.
6) Return the last node.

class Solution {
    public Node flatten(Node head) {
        dfs(head);
        return head;
    }
    public static Node dfs(Node head){
        Node curr=head;
        Node last=null;
        while(curr!=null){
            Node next=curr.next;
            if(curr.child!=null){                                  // if child exist then apply dfs to curr.child.
                Node childtail=dfs(curr.child);
                curr.next=curr.child;                             // connect curr.next to its child. and also the child.prev to curr.
                curr.child.prev=curr;
                if(next!=null){                                      // if the saved next is not null then connect the childtail to next and its prev too.
                    childtail.next=next;
                    next.prev=childtail;
                }
                curr.child=null;                                    // disconnect the old child link of curr.
                last=childtail;
                curr=childtail;
            }else{
                last=curr;                                          // last keeps track of the last processed node in the current flattened segment.
            }
            curr=curr.next;                                             // move curr pointer ahead.
        }
        return last;
    }
}
Time-O(n)
Space-O(n)


26)  // IMPLEMENT LRU CACHE CLASS.

class LRUCache {
    Node head=new Node(0,0);
    Node tail=new Node(0,0);
    Map<Integer,Node> map=new HashMap<>();
    int capacity;

    public LRUCache(int capacity) {
        this.capacity=capacity;
        head.next=tail;
        tail.prev=head;
    }
    
    public int get(int key) {
        if(map.containsKey(key)){
            Node data=map.get(key);
            remove(data);                            // remove data from the top.
            insert(data);                            // insert at the top.
            return data.value;
        }
        return -1;                                  // if not found return -1;
    }
    
    public void put(int key, int value) {
        if(map.containsKey(key)){                           // if already present then remove it.
         remove(map.get(key));
        }
        if(capacity==map.size()){                             // if capacity full then remove the least recently used data that is tail.prev.
            remove(tail.prev);
        }
        insert(new Node(key,value));                          // and finally insert the new data.
    }
    void remove(Node node){                                   // for removing, first remove from the map and then diconnect the links.
         map.remove(node.key);
         node.prev.next=node.next;
         node.next.prev=node.prev;
    }
    void insert(Node node){
        map.put(node.key,node);
        Node headnext=head.next;                               // first insert in the map and then join the links.
        head.next=node;
        node.prev=head;
        headnext.prev=node;
        node.next=headnext;
    }
    class Node{
        Node prev,next;
        int key,value;
        Node(int key,int value){
            this.key=key;
            this.value=value;
        }
    }
}
