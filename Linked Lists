9)  // Add two numbers.

class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        ListNode copy=dummy;
        int carry=0;
        while(l1!=null || l2!=null){//works if either of the 2 condition is true
            int sum=0+carry;
            if(l1!=null){
             sum=sum+l1.val;
             l1=l1.next;
            }
            if(l2!=null){
                sum=sum+l2.val;
                l2=l2.next;
            }
            carry=sum/10;
            sum=sum%10;
            dummy.next=new ListNode(sum);
            dummy=dummy.next;
        }
        if(carry==1) dummy.next=new ListNode(1);
        return copy.next;
    }
}


10)  // Remove Duplicates from Sorted Lists.

class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        if(head==null || head.next==null) return head;
        ListNode prenode=head;
        ListNode curr=head.next;
        while(curr!=null){
            if(curr.val!=prenode.val){                          // Found a unique value.
                prenode.next=curr;                               // Link to unique node.
                prenode=curr;                                  // Move prenode forward.
            }
            curr=curr.next;                                         // If duplicate, just skip (move curr only).
        }
        prenode.next=null;                                       // Cut off any remaining duplicates at the end
        return head;
    }
}


