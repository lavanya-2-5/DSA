        newlist.next=list1;
    }
        return headnode.next;
    }
}


9)  // Add two numbers.

class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        ListNode copy=dummy;
        int carry=0;
        while(l1!=null || l2!=null){//works if either of the 2 condition is true
            int sum=0+carry;
            if(l1!=null){
             sum=sum+l1.val;
             l1=l1.next;
            }
            if(l2!=null){
                sum=sum+l2.val;
                l2=l2.next;
            }
            carry=sum/10;
            sum=sum%10;
            dummy.next=new ListNode(sum);
            dummy=dummy.next;
        }
        if(carry==1) dummy.next=new ListNode(1);
        return copy.next;
    }
}


10)  // Remove Duplicates from Sorted Lists.

class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        if(head==null || head.next==null) return head;
        ListNode prenode=head;
        ListNode curr=head.next;
        while(curr!=null){
            if(curr.val!=prenode.val){                          // Found a unique value.
                prenode.next=curr;                               // Link to unique node.
                prenode=curr;                                  // Move prenode forward.
            }
            curr=curr.next;                                         // If duplicate, just skip (move curr only).
        }
        prenode.next=null;                                       // Cut off any remaining duplicates at the end
        return head;
    }
}


11)  // Intersection of two linked list. Find the intersection node.

public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
        ListNode l1=headA;
        ListNode l2=headB;
        while(l1!=l2){                           // checking for refrence not value.
            if(l1==null){
                l1=headB;
            }else{
                l1=l1.next;
            }
            if(l2==null){
                l2=headA;
            }else{
                l2=l2.next;
            }
        }
        return l1;
    }
}
Time-O(n+m)
Space-O(1)
This ensures both pointers travel the same total distance (lengthA + lengthB).


12)  // Palindrome Linked Lists.

3 steps-1) find middle .
        2) reverse the second half.
        3) compare both halves.

class Solution {
    public boolean isPalindrome(ListNode head) {
        ListNode slow=head;
        ListNode fast=head;                                 // find middle using slow-fast pointer.
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        ListNode prev=null;
        while(slow!=null){                                 // reverse the 2nd half using prev,curr,next variables.
            ListNode next=slow.next;
            slow.next=prev;
            prev=slow;
            slow=next;
        }
        ListNode l1=head;
        ListNode l2=prev;
        while(l2!=null){                              // compare both halves.
            if(l1.val!=l2.val) return false;
            l1=l1.next;
            l2=l2.next;
        }
        return true;
    }
}
Time-O(n)
Space-O(1)


13)  // Remove all occurences of an element in Linked List .

class Solution {
    public ListNode removeElements(ListNode head, int val) {
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        dummy.next=head;
        ListNode curr=dummy;
        while(curr.next!=null){
          if(curr.next.val==val){
            curr.next=curr.next.next;
          }else{
            curr=curr.next;
          }
        }
        return dummy.next;
    }
}
Time-O(n)
Space-O(1)
Use a dummy node pointing to the head to handle cases where the head itself needs to be deleted.
Then traverse the list and whenever the next node's value equals the target value,
skip that node by updating the pointer. Otherwise, I move forward.


14)  // Odd Even linked lists.

class Solution {
    public ListNode oddEvenList(ListNode head) {
        if(head==null) return null;
        if(head.next==null) return head;
        ListNode Odd=head;
        ListNode Even=head.next;
        ListNode sec=head.next;
        while(Even!=null && Even.next!=null){
            Odd.next=Even.next;
            Odd=Odd.next;
            Even.next=Odd.next;
            Even=Even.next;
        }
        Odd.next=sec;                                           //  connect the end of the odd list to the head of the even list.
        return head;
    }
}
Time-O(n)
Space-O(1)


15)  // Merge k sorted lists.

1) Insert the first node of every list into the heap.
2) Remove the smallest node from the heap.
3) Add it to the result list.
4) If that node has a next node, insert it into the heap.
5) Repeat until heap becomes empty.

class Solution {
    public ListNode mergeKLists(ListNode[] lists) {
        PriorityQueue<ListNode> pq=new PriorityQueue<>((a,b)->a.val-b.val);
        for(ListNode node:lists){
            if(node!=null){
                pq.add(node);
            }
        }
        ListNode dummy=new ListNode(Integer.MIN_VALUE);
        ListNode temp=dummy;
        while(!pq.isEmpty()){
            ListNode minNode=pq.poll();
            temp.next=minNode;
            temp=temp.next;
            if(minNode.next!=null){
                pq.add(minNode.next);
            }
        }
        return dummy.next;
    }
}
Time-O(n log k)
Space-O(k)

Another Approach-
Repeatedly merge two lists.
class Solution {
    public ListNode mergeKLists(ListNode[] lists) {
        if(lists == null || lists.length == 0) return null;
        return divide(lists, 0, lists.length - 1);
    }
    public ListNode divide(ListNode[] lists, int left, int right){
        if(left == right){                                                   // if single list is there then return it.
            return lists[left];
        }
        int mid = left + (right - left) / 2;                                     // keep dividing until it becomes 1.
        ListNode l1 = divide(lists, left, mid);
        ListNode l2 = divide(lists, mid + 1, right);
        return mergeTwoLists(l1, l2);
    }
    public ListNode mergeTwoLists(ListNode l1, ListNode l2){
        ListNode dummy = new ListNode(-1);
        ListNode temp = dummy;
        while(l1 != null && l2 != null){
            if(l1.val <= l2.val){
                temp.next = l1;
                l1 = l1.next;
            }
            else{
                temp.next = l2;
                l2 = l2.next;
            }
            temp = temp.next;
        }
        if(l1 != null) temp.next = l1;
        else temp.next = l2;
        return dummy.next;
    }
}
Time-O(n log k)
Space-O(1)


16)  // Sort lists.

1) Find the middle of the list
2) Split the list into two halves
3) Sort each half recursively
4) Merge the two sorted halves

class Solution {
    public ListNode sortList(ListNode head) {
        if(head == null || head.next == null){
            return head;
        }
        ListNode mid = getMiddle(head);             
        ListNode right = mid.next;                                  // making the list after mid as right list.
        mid.next = null;                                              // separating the list after mid.
        ListNode leftSorted = sortList(head);                           // again dividing the left list using mid.
        ListNode rightSorted = sortList(right);                          
        return merge(leftSorted, rightSorted);
    }
    public ListNode getMiddle(ListNode head){                                // finding middle using slow fast pointer.
        ListNode slow = head;
        ListNode fast = head.next;                                                // here the fast pointer starts from the head.next.
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow;                                              // returning mid.
    }
    public ListNode merge(ListNode l1, ListNode l2){                      // same logic for merging 2 list.
        ListNode dummy = new ListNode(-1); 
        ListNode temp = dummy;
        while(l1 != null && l2 != null){
            if(l1.val <= l2.val){
                temp.next = l1;
                l1 = l1.next;
            }
            else{
                temp.next = l2;
                l2 = l2.next;
            }
            temp = temp.next;
        }
        if(l1 != null) temp.next = l1;
        else temp.next = l2;
        return dummy.next;
    }
}
Time-O(n log n)
Space-O(log n)


