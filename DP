class Solution {
    public int jump(int[] nums) {
        int j=0;                                      // no. of jumps.
        int rangeEnd=0;                                       // only counting when i==end of a range.
        int far=0;                                    // counting min. number if jumps.
        for(int i=0;i<nums.length-1;i++){
