class Solution {
    public int uniquePaths(int m, int n) {
        int[] dp = new int[n];
        Arrays.fill(dp, 1);                                      // using only 1 array and modifying values for m-1 iterations.
        for (int i = 1; i < m; i++) {
            for (int j = 1; j < n; j++) {
                dp[j] = dp[j] + dp[j-1];
            }
        }
        return dp[n-1];
    }
}
space-O(n)


10)  // Unique Paths 2.

class Solution {
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        int m=obstacleGrid.length;
        int n=obstacleGrid[0].length;
        if(obstacleGrid[0][0]==1 || obstacleGrid[m-1][n-1]==1) return 0;              // id starting or ending is an obstacle then return 0.
        int[][] dp=new int[m][n];
        dp[0][0]=1;                                                               // else starting will be 1.
        for(int i=1;i<m;i++){
            if(obstacleGrid[i][0]==1){                                              // setting the 1st column to 1.
                dp[i][0]=0;
            }else{
                dp[i][0]=dp[i-1][0];                                               // if not an obstacle then copy the previous value.
            }
        }
        for(int j=1;j<n;j++){                                          // setting the first row to 1.
            if(obstacleGrid[0][j]==1){
                dp[0][j]=0;
            }else{
                dp[0][j]=dp[0][j-1];
            }
        }
        for(int i=1;i<m;i++){                                               // starting from dp[1][1] and filling the values if not an obstacle.
            for(int j=1;j<n;j++){
                if(obstacleGrid[i][j]==1){
                    dp[i][j]=0;
                }else{
                dp[i][j]=dp[i-1][j]+dp[i][j-1];
            }}
        }
        return dp[m-1][n-1];
    }
}
Time-O(n*m)
Space-O(n*m)

