class Solution {
    public int[] countBits(int n) {
         int[] dp = new int[n + 1];
    for (int i=1; i<=n; i++){
        dp[i] = dp[i >> 1] + (i & 1);                 // take right shift and then add i%2.
      }
    return dp;
    }
}

