class Solution {
    public int longestCommonSubsequence(String text1, String text2) {
       int m=text1.length();
       int n=text2.length();
       int[][] dpGrid=new int[m+1][n+1];
       for(int i=1;i<=m;i++){
        for(int j=1;j<=n;j++){
            if(text1.charAt(i-1)!=text2.charAt(j-1)){                                   // if last letter not same , then choose max of up or left value.
                dpGrid[i][j]=Math.max(dpGrid[i-1][j],dpGrid[i][j-1]);
            }
            else{
                dpGrid[i][j]=dpGrid[i-1][j-1]+1;                                       // if last letter matches, then copy the diagonal value and + 1 to it.
            }
        }
       }
      return dpGrid[m][n];
    }
}
Time-O(n*m)
Space-O(n*m)

