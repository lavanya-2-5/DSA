1)  // Climbing Stairs.

int climb(int n) {
    if (n <= 1) return 1;                   // base case.
    int[] dp = new int[n + 1];
    dp[1] = 1;                                   // bottom up(tabulation).
    dp[2] = 2;
    for (int i = 3; i <= n; i++) {
        dp[i] = dp[i - 1] + dp[i - 2];                 // using already computed values.
    }
    return dp[n];
}

Space OPTIMIZED WAY-
int climb(int n) {
    if (n <= 1) return 1;
    int prev2 = 1;                          // no array used for storing.
    int prev1 = 1;
    for (int i = 2; i <= n; i++) {
        int curr = prev1 + prev2;            // calculating on the fly.
        prev2 = prev1;
        prev1 = curr;
    }
    return prev1;
}


