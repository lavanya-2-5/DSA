class Solution {
    public int climbStairs(int n, int[] costs) {
        int[] dp=new int[n+1];
         dp[0]=0;
        for(int i=1;i<=n;i++){
            int minC=Integer.MAX_VALUE;
            if(i-1>=0){
              minC=Math.min(minC,dp[i-1]+1);
            }
            if(i-2>=0){
              minC=Math.min(minC,dp[i-2]+4);
            }
            if(i-3>=0){
              minC=Math.min(minC,dp[i-3]+9);
            }
           dp[i]=costs[i-1]+minC;
        }
        return dp[n];
    }
}
Time-O(N)
Space-O(N)


