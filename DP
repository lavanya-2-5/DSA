class Solution {
    public int minPathSum(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int[] dp = new int[n];
        dp[0] = grid[0][0];                                                            // Initialize start.
        for (int j = 1; j < n; j++) {                                                 // First row.
            dp[j] = grid[0][j] + dp[j - 1];
        }                                                                                 
        for (int i = 1; i < m; i++) {                                               // Remaining rows.
            dp[0] = grid[i][0] + dp[0];                                          // first column.
            for (int j = 1; j < n; j++) {
                dp[j] = grid[i][j] + Math.min(dp[j], dp[j - 1]);
            }
        }
        return dp[n - 1];
    }
}
Space-O(n)


13)  // Target Sum.

class Solution {
    public int findTargetSumWays(int[] nums, int target) {
        int tsum=0;
        for(int num:nums){
            tsum+=num;
        }
        if((tsum+target)%2!=0) return 0;                               // Left side is always even.
        if(Math.abs(target)>tsum) return 0;
        int P=(tsum+target)/2;                                       // 2 * sum(P) = target + totalSum.
        int[] dp=new int[P+1];
        dp[0]=1;
        for(int num:nums){
            for(int i=P;i>=num;i--){
                dp[i]=dp[i]+dp[i-num];
            }
        }
        return dp[P];
    }
}
Time-O(n*p)
Space-O(p)


