        int prev2 = nums[0];                                           // dp[0]
        int prev1 = Math.max(nums[0], nums[1]);                             // dp[1]
        for (int i = 2; i < n; i++) {
            int curr = Math.max(prev1, prev2 + nums[i]);
            prev2 = prev1;
            prev1 = curr;
        }
        return prev1;
    }
}


