class Solution {
     int[][] dir = {{1,0}, {-1,0}, {0,1}, {0,-1}};
    public int getMaximumGold(int[][] grid) {
         int n=grid.length;
        int m=grid[0].length;
        int maxgold=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]>0){
                maxgold=Math.max(maxgold,dfshelper(grid,i,j));
                }
            }
        }
        return maxgold;
    }
  public int dfshelper(int[][] grid,int i,int j){
     int n=grid.length;
        int m=grid[0].length;
     int gold=grid[i][j];
      grid[i][j]=0;
      int mg=0;
      for(int[] d:dir){
      int nr=i+d[0];
      int nc=j+d[1];
      if(nr>=0 && nc>=0 && nr<n && nc<m && grid[nr][nc]>0){
        mg=Math.max(mg,dfshelper(grid,nr,nc));
      }
      }
      grid[i][j]=gold;
      return gold+mg;
  }
}

