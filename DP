class Solution {
    public int coinChange(int[] coins, int amount) {
        int[] dp=new int[amount+1];
        Arrays.fill(dp,amount+1);
         dp[0]=0;
        for(int i=1;i<=amount;i++){
            for(int coin:coins){
                if(i-coin>=0){
             dp[i]=Math.min(dp[i],1+dp[i-coin]);                       // Optimization (min/max) → use min/max, amount outer loop.
                }
            }
        }
        if(dp[amount]>amount){
            return -1;
        }else{
            return dp[amount];
        }
    }
}
Time-O(amt* no. of coins)
Space-O(amt)


