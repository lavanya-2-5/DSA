1)  // Assign Cookies.

class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);
        Arrays.sort(s);
        int c=0;                            
        int i=0;                                                  //two pointers.
        int j=0;
        while(i<g.length && j<s.length){                                        //maximize count-> no. of satisfied children;
            if(s[j]>=g[i]){                                       //cookie satisfies child then increment count.
             c++;
             i++;                      //move to next child.
             j++;                       //move to next cookie.
            }else{
                j++;                                           //if cookie too small, discard it.
            }
        } 
        return c;
    }
}
Time- O(nlogn + mlogm)
Space-O(1).


2)  // Array Partition. ->maximize sum.

class Solution {
    public int arrayPairSum(int[] nums) {                        
        Arrays.sort(nums);                               //When only the minimum of a pair matters, pair numbers as close as possible.
        int s=0;
        for(int i=0;i<nums.length;i+=2){
         s+=nums[i];                               //only keep adding the even indices number as they are the min. that gives max. sum.
        }
        return s;
    }
}
Time-O(n log n)
Space-O(log n)-> sorting stack.


3)  // Can Place Flower.

class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
        if(n==0) return true;
        for(int i=0;i<flowerbed.length;i++){
            if(flowerbed[i]==0){
                int prev=(i==0)?0:flowerbed[i-1];                         //assign prev value for index 0 as well.
                int next=(i==flowerbed.length-1)?0:flowerbed[i+1];            //assign next value for last index as well. 
                if(prev==0 && next==0){
                    flowerbed[i]=1;
                    n--;
                    if(n==0) return true;
                }
            }
        }
        return false;
    }
}
Time-O(n)
Space-O(1) in place.


4)  // Lemonade Change.

class Solution {
    public boolean lemonadeChange(int[] bills) {
        int fv=0;                                          // we need only five and ten rupee for change not 20.
        int ten=0;
        for(int bill:bills){
            if(bill==5){                                                   // if bill is 5 then we just accept it.
                fv++;
            }else if(bill==10){                            
                if(fv==0) return false;                             // if bill is 10 but we dont have 5 then return false.
                fv--;                                            // if we have a 5 then we decrement its count but increment the 10 count.
                ten++;
            }else{                                              // if we get a 20 bill.
                if(ten>0 && fv>0){                            //here we have 2 options , either we can give one 10 and one 5 rupee.
                    ten--;
                    fv--;
                }else if(fv>=3){                                     // another option is we can give three 5 rupees, and decrement its count. 
                    fv=fv-3;
                }else{
                    return false;                             // if any other option left then return false. otherwise true.
                }
            }
        }
        return true;
    }
}
Time-O(n)
Space-O(1)


5)  // Activity Selection.

class Solution {
    public int activitySelection(int[] start, int[] finish) {

        int n = start.length;
        int[][] arr = new int[n][2];                                  // Create array of activities.
        for (int i = 0; i < n; i++) {
            arr[i][0] = start[i];
            arr[i][1] = finish[i];
        }                                                       
        Arrays.sort(arr, new Comparator<int[]>() {                   // Sort by finish time
            public int compare(int[] a, int[] b) {
                return a[1] - b[1];
            }
        });
        int count = 1;
        int lastFinish = arr[0][1];
        for (int i = 1; i < n; i++) {
            if (arr[i][0] > lastFinish) {                       
              count++;
                lastFinish = arr[i][1];
            }
        }

        return count;
    }
}
Time-O(n log n)
Space-O(n)


6)  // Minimum Platform.

class Solution {
    public int minPlatform(int arr[], int dep[]) {
        Arrays.sort(arr);
        Arrays.sort(dep);
        int maxpl=0;
        int platform=0;
        int i=0;
        int j=0;
        int n=arr.length;
        while(i<n && j<n){
            if(arr[i]<=dep[j]){
                platform++;                                   //how many trains arrive before one departs->that many platforms needed.
                i++;
            }else{
                platform--;                                  //if the train departs then platform--.
                j++;
            }
            maxpl=Math.max(maxpl,platform);
        }
        return maxpl;
    }
}
Time-O(n log n)
Space-O(1)


7)  // Coin Change.

class Solution {
    public int coinChange(int[] coins, int amount) {
        int[] dp=new int[amount+1];
        Arrays.fill(dp,amount+1);
         dp[0]=0;
        for(int i=1;i<=amount;i++){
            for(int coin:coins){
                if(i-coin>=0){
             dp[i]=Math.min(dp[i],1+dp[i-coin]);         //dp approach(bottom up)
                }
            }
        }
        if(dp[amount]>amount){
            return -1;
        }else{
            return dp[amount];                        //Use one coin now + best way to make the remaining amount.
        }
    }
}
Time-O(amt*no. of coins)
Space-O(amt)


8)  // Max. chunks to make sorted.     -> If max(arr[0..i]) == i → CUT NOW

class Solution {
    public int maxChunksToSorted(int[] arr) {
        int max=0;
        int chunks=0;
        for(int i=0;i<arr.length;i++){
            max=Math.max(max,arr[i]);
            if(max==i){                                    //we can cut the chunk at that index only if all the values upto index i lies within that index i.
                chunks++;
            }
        }
        return chunks;
    }
}
Time-O(N)
Space-O(1)


9)  // Max chunks to make sorted 2.

class Solution {
    public int maxChunksToSorted(int[] arr) {
        int n=arr.length;
        int[] lm=new int[n];
        int[] rm=new int[n];
        lm[0]=arr[0];
        for(int i=1;i<n;i++){
            lm[i]=Math.max(arr[i],lm[i-1]);               //max. on the left side after breaking on every index.
        }
        rm[n-1]=arr[n-1];
        for(int i=n-2;i>=0;i--){
            rm[i]=Math.min(arr[i],rm[i+1]);                //min. on the right side after breaking on every index.
        }
        int chunks=1;
       for(int i=0;i<n-1;i++){
        if(lm[i]<=rm[i+1]){                      //max. on the left must be less than or equal to the min. on the rigth after splitting then it will be sorted.
            chunks++;
        }
       }
       return chunks;
    }
}
Time-O(n)
Space-(n)


10)  // 0-1 Knapsack.

class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        int n=val.length;
        int[] dp=new int[W+1];
        for(int i=0;i<n;i++){
            for(int w=W;w>=wt[i];w--){
                dp[w]=Math.max(dp[w],val[i]+dp[w-wt[i]]);
            }
        }
        return dp[W];
    }
}
dp[w] always stores the best value achievable for capacity w using items seen so far, and backward looping ensures each item is counted at most once.
Time-O(n*w).
Space-O(w).
