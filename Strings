KMP(Knuth-Morris Pratt Algo)-
1) Build LPS array for needle.
2) Traverse haystack and needle together.
3) If characters match → move both pointers.
4) If mismatch → jump using LPS instead of restarting.

class Solution {
    public int strStr(String haystack, String needle) {
        if(needle.length() == 0) return 0;
        int[] lps = buildLPS(needle);
        int i = 0;                                                            // haystack pointer
        int j = 0;                                                                // needle pointer
        while(i < haystack.length()){
            if(haystack.charAt(i) == needle.charAt(j)){
                i++;
                j++;
            }
            if(j == needle.length()){
                return i - j;
            }
            else if(i < haystack.length() && haystack.charAt(i) != needle.charAt(j)){
                if(j != 0){
                    j = lps[j-1];
                }
                else{
                    i++;
                }
            }
        }
        return -1;
    }
    public int[] buildLPS(String pattern){
        int[] lps = new int[pattern.length()];
        int len = 0;
        int i = 1;
        while(i < pattern.length()){
            if(pattern.charAt(i) == pattern.charAt(len)){
                len++;
                lps[i] = len;
                i++;
            }
            else{
                if(len != 0){
                    len = lps[len-1];
                }
                else{
                    lps[i] = 0;
                    i++;
                }
            }
        }
        return lps;
    }
}
Time-O(n+m)
Space-O(m)
