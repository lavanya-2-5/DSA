1) Find the score difference in a game.

class Solution {
    public int scoreDifference(int[] nums) {
        int flag=1;
        int scoreA=0;
        int scoreB=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]%2!=0){
                flag=1-flag;
            }
            if(i%6==5){
                flag=1-flag;;
            }
            if(flag==1){
                scoreA+=nums[i];
            }else{
                scoreB+=nums[i];
            }
        }
        return scoreA-scoreB;
    }
}


2) Maximum Bitwise XOR after rearrangement

class Solution {
    public String maximumXor(String s, String t) {
        int count1 = 0;
        int count0 = 0;
        for (int i = 0; i < t.length(); i++) {
            if (t.charAt(i) == '1') {
                count1++;
            } else {
                count0++;
            }
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == '1'){
                if (count0 > 0) {
                    sb.append('1');   
                    count0--;
                } else {
                    sb.append('0');  
                    count1--;
                }
            } else { 
                if (count1 > 0) {
                    sb.append('1');  
                    count1--;
                } else {
                    sb.append('0');   
                    count0--;
                }
            }
        }
        return sb.toString();
    }
}
