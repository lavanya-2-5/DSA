1)  // Print an adjacency list.

class Solution {
    public List<List<Integer>> printGraph(int V, int edges[][]) {
        List<List<Integer>> adj=new ArrayList<>();
        for(int i=0;i<V;i++){
            adj.add(new ArrayList<>());
        }
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            adj.get(u).add(v);                                             // undirected graph so we add nodes both way. 
            adj.get(v).add(u);                                          // an edge represents two way connection.
        }
        return adj;
    }
}
Time-O(v+e)
Space-O(v+e)


2)  // BFS of Graph (Breadth First Search).

class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
        
        int v=adj.size();
        ArrayList<Integer> res=new ArrayList<>();
        Queue<Integer> q=new LinkedList<>();
        boolean[] vis=new boolean[v];
        q.add(0);
        vis[0]=true;
        while(!q.isEmpty()){
            int node=q.poll();
            res.add(node);
            for(int neighbour:adj.get(node)){
                if(!vis[neighbour]){
                    vis[neighbour]=true;
                    q.add(neighbour);
                }
            }
        }
        return res;
    }
}
Time-O(v+e)
Space-O(v)
If a starting node is not specified or graph may be disconnected, we run BFS from every unvisited node.


3)  // DFS of Graph (Depth First Search).

class Solution {
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        int v=adj.size();
        boolean[] vis=new boolean[v];
        ArrayList<Integer> res=new ArrayList<>();
        helper(0,adj,vis,res);
        return res;
    }
    public void helper(int node,ArrayList<ArrayList<Integer>> adj,
    boolean[] vis,ArrayList<Integer> res){
        vis[node]=true;
        res.add(node);
        for(int neighbour:adj.get(node)){
            if(!vis[neighbour]){
                helper(neighbour,adj,vis,res);
            }
        }
    }
}
Time-O(v+e)
Space-O(v)

DFS FOR DISCONNECTED GRAPH-
class Solution {
    public ArrayList<Integer> dfsOfGraph(int V, ArrayList<ArrayList<Integer>> adj) {
        boolean[] visited = new boolean[V];
        ArrayList<Integer> dfs = new ArrayList<>();
        for (int i = 0; i < V; i++) {                                        // This loop handles DISCONNECTED graphs
            if (!visited[i]) {
                dfsHelper(i, adj, visited, dfs);
            }
        }   
        return dfs;
    }
    private void dfsHelper(int node, ArrayList<ArrayList<Integer>> adj,
                           boolean[] visited, ArrayList<Integer> dfs) {
        visited[node] = true;                                                   // Step 1: mark visited
        dfs.add(node);                                                             // Step 2: add to answer
        for (int neigh : adj.get(node)) {                                         // Step 3: go deep into neighbours
            if (!visited[neigh]) {
                dfsHelper(neigh, adj, visited, dfs);
            }
        }
    }
}


