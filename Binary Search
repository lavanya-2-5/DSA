1)  // Lower Bound-The lower bound of a number is defined as the smallest index in the sorted array where the element is greater than or equal to the given number.

Using linear search-O(N) but Using binary seach -O(logN).

class Solution {
    int lowerBound(int[] arr, int target) {
        int l=0;
        int h=arr.length-1;
        int result=arr.length;
        while(l<=h){
            int mid=l+(h-l)/2;
            if(arr[mid]>=target){
                result=mid;
                h=mid-1;
            }else{
                l=mid+1;
            }
        }
        return result;
    }
}


2)  // KOKO eating bananas - Return the minimum integer k such that she can eat all the bananas within h hours.

class Solution {
    public int minEatingSpeed(int[] piles, int h) {        //BINARY SEARCH ON ANSWER.
        int low=1;
        int high=0;
        for(int num:piles){
            high=Math.max(high,num);                    //finding max. in the array as the upper limit.
        }
        int ans=high;
        while(low<=high){
            int mid=low+(high-low)/2;
            long hours=computeH(piles,mid);
            if(hours<=h){
                ans=mid;                         //possibly an answer but have to search for mid-1 .
                high=mid-1;  
            }else{
                low=mid+1;                           //speed is too slow.
            }
        }
     return ans;
    }
    public long computeH(int[] piles,int mid){           //finding total hours taken to complete mid bananas in 1 hour.
        long hrsSum=0;
        for(int p:piles){
            hrsSum+=(p+mid-1)/mid;
        }
        return hrsSum;
    }
}


3)  // First Bad Version- Suppose you have n versions [1, 2, ..., n] and you want to find out the first bad one, which causes all the following ones to be bad.You 
are given an API bool isBadVersion(version) which returns whether version is bad. 

public class Solution extends VersionControl {     //BINARY SEARCH ON ANSWER.
    public int firstBadVersion(int n) {
        int l=1;
        int h=n;
        int ans=0;
        while(l<=h){
            int mid=l+(h-l)/2;
            if(isBadVersion(mid)==true){
              ans=mid;
              h=mid-1;
            }else{
                l=mid+1;
            }
        }
        return ans;
    }
}


4)  // Search in rotated sorted array.

class Solution {
    public int search(int[] nums, int target) {                                             
        int rotatedIndex=binS(nums);                           //find the index at which the array is rotated.
        if(rotatedIndex==0){                                          //if the array is not rotated.
            return binS2(nums,0,nums.length-1,target);               
        }
        if(target>=nums[0]){                                   //search only in the left part.
         return binS2(nums,0,rotatedIndex-1,target);
        }
        else{                                                     //search only in the right part.
         return binS2(nums,rotatedIndex,nums.length-1,target);
        }
    }
    public int binS(int[] nums){                             //searching the rotatedIndex.
        int start=0;
        int end=nums.length-1;
        while(start<end){
            int mid=start+(end-start)/2;
            if(nums[mid]>nums[end]){
                start=mid+1;
            }else{
                end=mid;
            }
        }
        return start;
    }
    public int binS2(int[] nums,int st,int en,int target){            //searching the target.
        while(st<=en){
            int m=st+(en-st)/2;
            if(nums[m]>target){
                en=m-1;
            }
            else if(nums[m]<target){
                st=m+1;
            }else if(nums[m]==target){
                return m;
            }
        }
        return -1;
    }
}


5)  // Search in Rotated Sorted Array 2.(With Duplicate Values).

class Solution {
    public boolean search(int[] nums, int target) {      //modified binary search.
        int left=0;
        int right=nums.length-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(nums[mid]==target){                      //if mid is the target.
                return true;
            }
            if(nums[mid]==nums[left] && nums[mid]==nums[right]){             //if all three values are same then shrink.
                left++;
                right--;
                continue;
            }
            else if(nums[left]<=nums[mid]){                                //if left half sorted then search.
                if(nums[left]<=target && nums[mid]>target){
                    right=mid-1;
                }else{
                    left=mid+1;
                }
            }
            else if(nums[mid]<=nums[right]){                               //if right half sorted then search.
                if(nums[mid]<target && target<=nums[right]){ 
                    left=mid+1;
                }else{
                    right=mid-1;
                }
            }
        }
        return false;
    }
}


6)  // Aggressive Cows. - finding minimum distance between any two of them which is maximum possible.

class Solution {                                               //BINARY SEARCH ON ANSWER.
    public int aggressiveCows(int[] stalls, int k) {
        Arrays.sort(stalls);
        int low=0;
        int high=stalls[stalls.length-1]-stalls[0];
        int ans=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(canPlaceCows(stalls,k,mid)){
                ans=mid;                                 //possibly an answer but need to check more minimum distance.
                low=mid+1;
            }else{
                high=mid-1;
            }
        }
        return ans;
    }
    public boolean canPlaceCows(int[] stalls,int k,int mid){  //binary search on minimum distance.
        int cows=1;
        int lastPos=stalls[0];
        for(int i=1;i<stalls.length;i++){
            if(stalls[i]-lastPos>=mid){
                cows++;
                lastPos=stalls[i];
            }
            if(cows>=k) return true;
        }
        return false;
    }
}
we apply binary search on minimum distance and see if that min. distance can place k cows.





 




