1)  // Implementation of Priority Queue.

class Geeks {
    static void insert(PriorityQueue<Integer> q, int k) {                  // Function to insert element into the queue.
      q.add(k);
       
    }
    static boolean find(PriorityQueue<Integer> q, int k) {                    // Function to find an element k.
      return q.contains(k);
    }
    static int delete(PriorityQueue<Integer> q) {                             // Function to delete the max element from queue.
        return q.poll();        
    }
}
Time Complexity- insert-O(log n)                                  //as PQ is implemented as Binary Heap,whose height is logn and heapify happens after each insertion.
                 find-O(n)
                 delete-O(log n)


2)  // Build Max Heap.

public class Solution {
    public static ArrayList<Integer> buildHeap(ArrayList<Integer> arr, int n) {
        for(int i=n/2-1;i>=0;i--){
            heapify(arr,n,i);
        }
        return arr;
    }
    public static void heapify(ArrayList<Integer> arr,int n,int i){
        int largest=i;
        int left=2*i+1;
        int right=2*i+2;
        if(left<n && arr.get(left)>arr.get(largest)){
            largest=left;
        }
        if(right<n && arr.get(right)>arr.get(largest)){
            largest=right;
        }
        if(largest!=i){
          int temp=arr.get(i);
          arr.set(i,arr.get(largest));
          arr.set(largest,temp);
        heapify(arr,n,largest);
        }
    }
}
Although heapify is O(log n), most heapify calls happen on nodes near the leaves where the height is very small, so the total cost of build-heap is O(n).
In-place heap sort first builds a max heap and then repeatedly moves the maximum element to the end of the array while maintaining the heap property.

3)  // Finding Kth largest element (not distinct).

class Solution {
    public int findKthLargest(int[] nums, int k) {                                       //Heap(PriorityQ -MinHeap(By default)).
        PriorityQueue<Integer> pq=new PriorityQueue<>(Collections.reverseOrder());
        for(int i=0;i<nums.length;i++){
            pq.add(nums[i]);                                                             //only add k no. of elements in the pq.
        }
       while(k>1){
       pq.poll();
       k--;
       }
       return pq.poll();
    }
}
tc & sc-> O(n log k), O(k).
Dont use the quicksort approach because its worst case is O(n^2) if pivot choice is bad.


4)  // Finding Kth Smallest element in an array.

class Solution {
    public int kthSmallest(int[] arr, int k) {                                         // using Heap(PriorityQ-MinHeap).
        PriorityQueue<Integer> pq=new PriorityQueue<>(Collections.reverseOrder());
        for(int i=0;i<arr.length;i++){
            pq.add(arr[i]);
            if(pq.size()>k){
                pq.poll();
            }
        }
        return pq.peek();
    }
}


5)  // Check Max Heap of a given binary tree.

class Solution {
    public boolean isHeap(Node tree) {
        if(tree==null) return true;
        Queue<Node> q=new LinkedList<>();
        q.add(tree);
        Boolean seenNull=false;
        while(!q.isEmpty()){                                            //level order traversal for checking completeness.
            Node cur=q.poll();
            if(cur==null){
                seenNull=true;
            }else{
                if(seenNull) return false;
                if(cur.left!=null && cur.data<cur.left.data){                  //parent>=children.
                    return false;
                }
                if(cur.right!=null && cur.data<cur.right.data){
                    return false;
                }
                 q.add(cur.left);                                          //add the children only when cur is not null otherwise it will give nullPointerException.
                 q.add(cur.right);
            }
        }
        return true;
    }
}


6)  // Top K frequent elements.

class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            map.put(nums[i],map.getOrDefault(nums[i],0)+1);
        }
        PriorityQueue<Integer> pq=new PriorityQueue<>((a,b)->map.get(a)-map.get(b));        //Min-Heap but comparison will be done on the basis of frequencies and not value.
        for(int num:map.keySet()){
            pq.add(num);                                                           //elements are getting added in the pq.
            if(pq.size()>k){
                pq.poll();                                                 //deleting on the basis of comparison of frequencies in min heap.(lowest freq. element is deleted)
            }
        }
        int[] res=new int[k];
        int i=0;
        while(!pq.isEmpty()){                                            //transfer the elements from pq into an array.
            res[i]=pq.poll();
            i++;
        }
        return res;
    }
}
Although we insert numbers into the priority queue, the comparator orders them based on their frequency stored in the hashmap, 
effectively making it a min-heap by frequency.


